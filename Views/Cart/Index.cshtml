@model CartViewModel
@{
    ViewData["Title"] = "السلة";
}

<h1 class="mb-4">السلة</h1>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">السلة فاضية. <a asp-controller="Menu" asp-action="Index">روح شوف المنيو</a></div>
}
else
{
    <div class="card p-3 mb-3">
      <div class="table-responsive" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
        <table class="table align-middle mb-0" style="min-width: 700px;">
            <thead>
                <tr>
                    <th>الصنف</th>
                    <th>السعر</th>
                    <th>الكمية</th>
                    <th>الإجمالي</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Name@(item.SizeName != null ? $" ({item.SizeName})" : "")</td>
                        <td>@item.Price.ToString("0.00") ج.م</td>
                        <td style="width:120px">
                            <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex gap-2">
                                <input type="hidden" name="menuItemId" value="@item.MenuItemId" />
                                <input type="hidden" name="sizeId" value="@item.SizeId" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="20" class="form-control form-control-sm" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">تحديث</button>
                            </form>
                        </td>
                        <td class="fw-bold">@item.LineTotal.ToString("0.00") ج.م</td>
                        <td>
                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                <input type="hidden" name="menuItemId" value="@item.MenuItemId" />
                                <input type="hidden" name="sizeId" value="@item.SizeId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">الإجمالي</th>
                    <th colspan="2" style="color:var(--color-primary)">@Model.Total.ToString("0.00") ج.م</th>
                </tr>
            </tfoot>
        </table>
        </div>
    </div>

    <a asp-controller="Order" asp-action="Checkout" class="btn btn-success btn-lg">إتمام الطلب</a>
    <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-secondary btn-lg">أضف أصناف تانية</a>
}
