@model CartViewModel
@{
    ViewData["Title"] = "السلة";
}

<h1 class="page-title">السلة</h1>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">السلة فاضية. <a asp-controller="Menu" asp-action="Index">روح شوف المنيو</a></div>
}
else
{
    <div class="row">
        <div class="col-lg-8">
            @foreach (var item in Model.Items)
            {
                <div class="card cart-line">
                    <div class="cart-line-head">
                        <div class="cart-line-name">@item.Name@(item.SizeName != null ? $" ({item.SizeName})" : "")</div>
                        <div class="cart-line-price">@item.Price.ToString("0.00") ج.م</div>
                    </div>
                    <div class="cart-line-actions">
                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="qty-form">
                            <input type="hidden" name="menuItemId" value="@item.MenuItemId" />
                            <input type="hidden" name="sizeId" value="@item.SizeId" />
                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="20" inputmode="numeric" class="form-control qty-input" aria-label="الكمية" />
                            <button type="submit" class="btn btn-outline-secondary">تحديث</button>
                        </form>
                        <div class="cart-line-total">@item.LineTotal.ToString("0.00") ج.م</div>
                        <form asp-controller="Cart" asp-action="Remove" method="post">
                            <input type="hidden" name="menuItemId" value="@item.MenuItemId" />
                            <input type="hidden" name="sizeId" value="@item.SizeId" />
                            <button type="submit" class="btn btn-outline-danger">حذف</button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card summary-box">
                <div class="summary-row total">
                    <span>الإجمالي</span>
                    <span>@Model.Total.ToString("0.00") ج.م</span>
                </div>
                <div class="d-grid gap-2 mt-3">
                    <a asp-controller="Order" asp-action="Checkout" class="btn btn-success btn-lg">إتمام الطلب</a>
                    <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-secondary">أضف أصناف تانية</a>
                </div>
            </div>
        </div>
    </div>
}
