@model MenuIndexViewModel
@{
    ViewData["Title"] = "المنيو";
    ViewData["Description"] = "منيو بابا المجال — أكلات شرقية وسورية: بيتزا، مشاوي، ساندوتشات وأكتر. اطلب أونلاين والدفع كاش عند الاستلام.";
}

<div class="menu-hero mb-3">
    <img src="~/images/auth-bg.webp" class="menu-hero-logo" alt="بابا المجال" />
    <div class="menu-hero-title">بابا المجال</div>
    <div class="menu-hero-sub">مطعم أكلات شرقية وسورية — مذاق شرقي أصيل</div>
</div>

@if (!Model.IsOpen)
{
    <div class="alert alert-warning">
        المطعم قافل دلوقتي. مواعيد الشغل: من @Model.OpenTime.ToString(@"hh\:mm") لحد @Model.CloseTime.ToString(@"hh\:mm").
        تقدر تتصفح المنيو، بس مش هتقدر تكمل الأوردر لحد ما نفتح.
    </div>
}

@if (!Model.Categories.Any())
{
    <div class="alert alert-info">لا يوجد أصناف متاحة حاليًا. برجاء المحاولة لاحقًا.</div>
}
else if (Model.Categories.Count > 1)
{
    <nav class="cat-chips" aria-label="أقسام المنيو">
        @foreach (var chip in Model.Categories)
        {
            <a class="cat-chip" href="#cat-@chip.CategoryId">@chip.CategoryName</a>
        }
    </nav>
}

<div class="row">
    @foreach (var category in Model.Categories)
    {
        <div class="col-lg-6">
            <div class="menu-panel" id="cat-@category.CategoryId">
                <div class="menu-panel-header">ركن @category.CategoryName</div>
                <div class="menu-panel-body">
                    <div class="row g-3">
                        @foreach (var item in category.Items)
                        {
                            <div class="col-12 col-md-6">
                                <div class="card h-100 menu-item-card">
                                    <div class="mi-top">
                                        <img src="@(string.IsNullOrEmpty(item.ImagePath) ? "/images/menu/placeholder.png" : "/images/menu/" + item.ImagePath)"
                                             class="mi-img" alt="@item.Name" loading="lazy" />
                                        <div class="mi-info">
                                            <h5 class="mi-title">@item.Name</h5>
                                            @if (!string.IsNullOrEmpty(item.Description))
                                            {
                                                <p class="mi-desc">@item.Description</p>
                                            }
                                            @{
                                                var hasRating = Model.Ratings.TryGetValue(item.Id, out var rating);
                                            }
                                            @if (hasRating)
                                            {
                                                <div class="small mb-1" style="color:var(--color-accent-dark)">
                                                    ⭐ @rating.Average.ToString("0.0") <span class="text-muted">(@rating.Count تقييم)</span>
                                                </div>
                                            }
                                            @{
                                                var hasDiscount = !item.HasSizes && item.EffectivePriceFor(Model.IsVip) < item.Price;
                                            }
                                            @if (!item.HasSizes && Model.IsVip && item.VipPrice.HasValue)
                                            {
                                                <span class="badge bg-dark mb-1">سعر مميز 👑</span>
                                            }
                                            else if (!item.HasSizes && item.DiscountedPrice.HasValue)
                                            {
                                                <span class="badge bg-danger mb-1">عرض خاص</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="mi-bottom">
                                        @if (item.HasSizes)
                                        {
                                            <form asp-controller="Cart" asp-action="Add" method="post" class="add-to-cart-form">
                                                <input type="hidden" name="menuItemId" value="@item.Id" />
                                                <div class="d-flex flex-column gap-2">
                                                    <select name="sizeId" class="form-select" aria-label="المقاس">
                                                        @foreach (var size in item.Sizes.OrderBy(s => s.DisplayOrder))
                                                        {
                                                            var sizePrice = size.EffectivePriceFor(Model.IsVip);
                                                            <option value="@size.Id">@size.Name — @sizePrice.ToString("0.00") ج.م</option>
                                                        }
                                                    </select>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <button type="submit" class="btn btn-primary flex-grow-1">أضف للسلة</button>
                                                        <input type="number" name="quantity" value="1" min="1" max="20" inputmode="numeric" class="form-control qty-input" aria-label="الكمية" />
                                                    </div>
                                                </div>
                                            </form>
                                        }
                                        else
                                        {
                                            var effectivePrice = item.EffectivePriceFor(Model.IsVip);
                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                <span class="mi-price">
                                                    @if (hasDiscount)
                                                    {
                                                        <del class="text-muted small fw-normal">@item.Price.ToString("0.00")</del>
                                                        <text> </text>
                                                    }
                                                    <span>@effectivePrice.ToString("0.00") ج.م</span>
                                                </span>
                                                <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex align-items-center gap-2 add-to-cart-form">
                                                    <input type="hidden" name="menuItemId" value="@item.Id" />
                                                    <button type="submit" class="btn btn-primary">أضف</button>
                                                    <input type="number" name="quantity" value="1" min="1" max="20" inputmode="numeric" class="form-control qty-input" aria-label="الكمية" />
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
