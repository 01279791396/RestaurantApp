@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var routeArea = (ViewContext.RouteData.Values["area"] as string) ?? "";
    var routeController = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var noIndex = routeArea == "Admin" || routeController is "Account" or "Cart" or "Order" or "Review";
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var canonicalUrl = baseUrl + Context.Request.Path.Value;
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrEmpty(pageTitle) ? "بابا المجال" : $"{pageTitle} - بابا المجال";
    var pageDescription = ViewData["Description"] as string
        ?? "بابا المجال — مطعم أكلات شرقية وسورية. اطلب من المنيو أونلاين، تابع أوردرك، والدفع كاش عند الاستلام.";
    var isAdminUser = SignInManager.IsSignedIn(User) && User.IsInRole("Admin");
    var cartCount = Context.Session.GetCart().Sum(i => i.Quantity);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@fullTitle</title>
    <meta name="description" content="@pageDescription" />
    @if (noIndex)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    else
    {
        <link rel="canonical" href="@canonicalUrl" />
        <meta property="og:type" content="restaurant.restaurant" />
        <meta property="og:locale" content="ar_AR" />
        <meta property="og:site_name" content="بابا المجال" />
        <meta property="og:title" content="@fullTitle" />
        <meta property="og:description" content="@pageDescription" />
        <meta property="og:url" content="@canonicalUrl" />
        <meta property="og:image" content="@(baseUrl)/icons/icon-512.png" />
        <meta name="twitter:card" content="summary" />
        <!-- بعد ما تسجل الموقع في Google Search Console، ضيف هنا سطر التحقق:
             <meta name="google-site-verification" content="XXXXXXXX" /> -->
    }
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#B8862B" />
    <link rel="icon" href="~/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="بابا المجال" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (!noIndex && routeController == "Menu")
    {
        <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "Restaurant",
            "name": "بابا المجال",
            "servesCuisine": ["أكلات شرقية", "أكلات سورية"],
            "url": "@baseUrl/Menu",
            "image": "@baseUrl/icons/icon-512.png",
            "inLanguage": "ar",
            "paymentAccepted": "Cash",
            "hasMenu": "@baseUrl/Menu"
        }
        </script>
    }
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md app-nav mb-4">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Menu" asp-action="Index">بابا المجال</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain" aria-controls="navMain" aria-expanded="false" aria-label="القائمة">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMain">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Menu" asp-action="Index">المنيو</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Cart" asp-action="Index">
                                السلة
                                <span id="cartBadge" class="badge bg-warning text-dark" style="display:@(cartCount > 0 ? "inline-block" : "none")">@cartCount</span>
                            </a>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">لوحة التحكم</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Category" asp-action="Index">إدارة الأقسام</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="MenuItem" asp-action="Index">إدارة المنيو</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Order" asp-action="Index">
                                        الأوردرات
                                        <span id="pendingOrdersBadge" class="badge bg-danger" style="display:none"></span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Coupon" asp-action="Index">أكواد الخصم</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Customer" asp-action="Index">العملاء</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Reports" asp-action="Index">التقارير</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Review" asp-action="Index">التقييمات</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Settings" asp-action="Index">مواعيد الشغل</a>
                                </li>
                            }
                            @if (User.IsInRole("Customer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Order" asp-action="MyOrders">أوردراتي</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <button id="pwaInstallBtn" type="button" class="btn btn-sm btn-warning me-2 my-2 my-md-0" style="display:none">
                                📲 ثبّت التطبيق
                            </button>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item d-flex align-items-center text-muted me-3 py-2 py-md-0">
                                مرحبًا، @User.Identity!.Name
                            </li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">تسجيل الخروج</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Register">إنشاء حساب</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-4">
        <div class="container text-center">
            &copy; @DateTime.Now.Year - بابا المجال
        </div>
    </footer>

    @* ---------- Phone bottom bar ---------- *@
    @if (isAdminUser)
    {
        <nav class="mobile-bottom-bar admin-bar" aria-label="تنقل الإدارة">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i>الرئيسية</a>
            <a asp-area="Admin" asp-controller="Order" asp-action="Index">
                <i class="bi bi-receipt"></i>الأوردرات
                <span class="bar-badge" id="pendingBadgeMobile" style="display:none"></span>
            </a>
            <a asp-area="Admin" asp-controller="MenuItem" asp-action="Index"><i class="bi bi-egg-fried"></i>المنيو</a>
            <a asp-area="Admin" asp-controller="Review" asp-action="Index"><i class="bi bi-star"></i>التقييمات</a>
            <button type="button" id="adminMoreBtn"><i class="bi bi-list"></i>المزيد</button>
        </nav>
    }
    else
    {
        <nav class="mobile-bottom-bar" aria-label="تنقل سريع">
            <a asp-area="" asp-controller="Menu" asp-action="Index"><i class="bi bi-grid"></i>المنيو</a>
            <a asp-area="" asp-controller="Cart" asp-action="Index">
                <i class="bi bi-bag"></i>السلة
                <span class="bar-badge" id="cartBadgeMobile" style="display:@(cartCount > 0 ? "block" : "none")">@cartCount</span>
            </a>
            @if (SignInManager.IsSignedIn(User))
            {
                <a asp-area="" asp-controller="Order" asp-action="MyOrders"><i class="bi bi-receipt"></i>أوردراتي</a>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit"><i class="bi bi-box-arrow-left"></i>خروج</button>
                </form>
            }
            else
            {
                <a asp-area="" asp-controller="Account" asp-action="Login"><i class="bi bi-person"></i>دخول</a>
                <a asp-area="" asp-controller="Account" asp-action="Register"><i class="bi bi-person-plus"></i>حساب جديد</a>
            }
        </nav>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/cart.js" asp-append-version="true"></script>
    <script src="~/js/site-mobile.js" asp-append-version="true"></script>
    @if (isAdminUser)
    {
        <script>
            (function () {
                var pendingUrl = '@Url.Action("PendingCount", "Order", new { area = "Admin" })';
                var badges = [document.getElementById('pendingOrdersBadge'), document.getElementById('pendingBadgeMobile')];
                var lastSeenId = null; // null = first check this page load; never beep on that one

                function beep() {
                    try {
                        var ctx = new (window.AudioContext || window.webkitAudioContext)();
                        var osc = ctx.createOscillator();
                        var gain = ctx.createGain();
                        osc.type = 'sine';
                        osc.frequency.value = 880;
                        gain.gain.setValueAtTime(0.15, ctx.currentTime);
                        osc.connect(gain);
                        gain.connect(ctx.destination);
                        osc.start();
                        osc.stop(ctx.currentTime + 0.35);
                    } catch (e) {
                        // Web Audio unsupported/blocked — silently skip, the badge still updates.
                    }
                }

                function showCount(count) {
                    badges.forEach(function (badge) {
                        if (!badge) return;
                        if (count > 0) {
                            badge.textContent = count;
                            badge.style.display = badge.id === 'pendingBadgeMobile' ? 'block' : 'inline-block';
                        } else {
                            badge.style.display = 'none';
                        }
                    });
                }

                function poll() {
                    fetch(pendingUrl, { credentials: 'same-origin' })
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .then(function (data) {
                            if (!data) return;

                            showCount(data.count);

                            if (lastSeenId !== null && data.latestId > lastSeenId) {
                                beep();
                            }
                            lastSeenId = data.latestId;
                        })
                        .catch(function () { /* network hiccup — try again next tick */ });
                }

                poll();
                setInterval(poll, 15000);
            })();
        </script>
    }
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js').catch(function () {
                    // Registration failing (unsupported browser, blocked, etc.) is not fatal —
                    // the site just works as a normal page without the installable/offline bits.
                });
            });
        }

        (function () {
            var installBtn = document.getElementById('pwaInstallBtn');
            var deferredPrompt = null;

            window.addEventListener('beforeinstallprompt', function (e) {
                e.preventDefault();
                deferredPrompt = e;
                if (installBtn) installBtn.style.display = 'inline-block';
            });

            if (installBtn) {
                installBtn.addEventListener('click', function () {
                    if (!deferredPrompt) return;
                    installBtn.style.display = 'none';
                    deferredPrompt.prompt();
                    deferredPrompt.userChoice.finally(function () { deferredPrompt = null; });
                });
            }

            window.addEventListener('appinstalled', function () {
                if (installBtn) installBtn.style.display = 'none';
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
