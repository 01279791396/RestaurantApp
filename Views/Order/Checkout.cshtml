@model CheckoutViewModel
@{
    ViewData["Title"] = "إتمام الطلب";
}

<h1 class="mb-4">إتمام الطلب</h1>

<div class="row g-4">
    <div class="col-md-7">
        <div class="card p-4">
            <h4 class="mb-3">بيانات التوصيل</h4>
            <form asp-action="Checkout" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="DeliveryAddress" class="form-label"></label>
                    <input asp-for="DeliveryAddress" class="form-control" />
                    <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CouponCode" class="form-label"></label>
                    <input asp-for="CouponCode" class="form-control" placeholder="لو معاك كود خصم" />
                    <span asp-validation-for="CouponCode" class="text-danger"></span>
                </div>

                <div class="alert alert-secondary">الدفع: كاش عند الاستلام</div>

                <button type="submit" class="btn btn-success btn-lg w-100">تأكيد الطلب</button>
            </form>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card p-4">
            <h4 class="mb-3">ملخص الطلب</h4>
            <ul class="list-group list-group-flush mb-0">
                @foreach (var item in Model.CartItems)
                {
                    <li class="list-group-item d-flex justify-content-between bg-transparent">
                        <span>@item.Name@(item.SizeName != null ? $" ({item.SizeName})" : "") × @item.Quantity</span>
                        <span>@item.LineTotal.ToString("0.00") ج.م</span>
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between fw-bold bg-transparent" style="color:var(--color-primary)">
                    <span>الإجمالي</span>
                    <span>@Model.Total.ToString("0.00") ج.م</span>
                </li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
