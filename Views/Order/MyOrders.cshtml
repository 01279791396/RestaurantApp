@model List<Order>
@{
    ViewData["Title"] = "أوردراتي";
    string StatusText(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "قيد الانتظار",
        OrderStatus.Accepted => "تم القبول",
        OrderStatus.Preparing => "جاري التحضير",
        OrderStatus.OutForDelivery => "مع مندوب التوصيل",
        OrderStatus.Delivered => "تم التسليم",
        OrderStatus.Cancelled => "ملغي",
        _ => s.ToString()
    };
    string BadgeClass(OrderStatus s) => s switch
    {
        OrderStatus.Delivered => "bg-success",
        OrderStatus.Cancelled => "bg-danger",
        OrderStatus.Pending => "bg-secondary",
        _ => "bg-warning text-dark"
    };
}

<h1 class="page-title">أوردراتي</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">لسه معملتش أي أوردر. <a asp-controller="Menu" asp-action="Index">اطلب دلوقتي</a></div>
}
else
{
    <div class="row">
        @foreach (var order in Model)
        {
            <div class="col-12 col-md-6">
                <a asp-action="Details" asp-route-id="@order.Id" class="card order-card">
                    <div class="order-card-top">
                        <span class="order-card-inv">@order.InvoiceNumber</span>
                        <span class="badge @BadgeClass(order.Status)">@StatusText(order.Status)</span>
                    </div>
                    <div class="order-card-meta">
                        <span>@order.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                        <span class="order-card-total">@order.GrandTotal.ToString("0.00") ج.م</span>
                    </div>
                </a>
            </div>
        }
    </div>
}
