@model OrderDetailsViewModel
@{
    ViewData["Title"] = "تفاصيل الطلب";
    var order = Model.Order;
    string statusText = order.Status switch
    {
        OrderStatus.Pending => "قيد الانتظار",
        OrderStatus.Accepted => "تم القبول",
        OrderStatus.Preparing => "جاري التحضير",
        OrderStatus.OutForDelivery => "مع مندوب التوصيل",
        OrderStatus.Delivered => "تم التسليم",
        OrderStatus.Cancelled => "ملغي",
        _ => order.Status.ToString()
    };
    string badgeClass = order.Status switch
    {
        OrderStatus.Delivered => "bg-success",
        OrderStatus.Cancelled => "bg-danger",
        OrderStatus.Pending => "bg-secondary",
        _ => "bg-warning text-dark"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>فاتورة رقم @order.InvoiceNumber</h1>
    <span class="badge @badgeClass fs-6">@statusText</span>
</div>

<div class="card p-4 mb-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">تاريخ الطلب</dt>
        <dd class="col-sm-9">@order.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>

        <dt class="col-sm-3">عنوان التوصيل</dt>
        <dd class="col-sm-9">@order.DeliveryAddress</dd>

        <dt class="col-sm-3">رقم الموبايل</dt>
        <dd class="col-sm-9">@order.PhoneNumber</dd>

        @if (!string.IsNullOrEmpty(order.Notes))
        {
            <dt class="col-sm-3">ملاحظات</dt>
            <dd class="col-sm-9">@order.Notes</dd>
        }

        @if (!string.IsNullOrEmpty(order.DeliveryPersonName))
        {
            <dt class="col-sm-3">مندوب التوصيل</dt>
            <dd class="col-sm-9">@order.DeliveryPersonName</dd>
        }
    </dl>
</div>

<div class="card p-3 mb-3">
<table class="table mb-0">
    <thead>
        <tr>
            <th>الصنف</th>
            <th>السعر</th>
            <th>الكمية</th>
            <th>الإجمالي</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in order.OrderItems)
        {
            <tr>
                <td>@item.ItemNameAtOrderTime@(item.SizeNameAtOrderTime != null ? $" ({item.SizeNameAtOrderTime})" : "")</td>
                <td>@item.UnitPriceAtOrderTime.ToString("0.00") ج.م</td>
                <td>@item.Quantity</td>
                <td>@item.LineTotal.ToString("0.00") ج.م</td>
                <td>
                    @if (order.Status == OrderStatus.Delivered)
                    {
                        <a asp-controller="Review" asp-action="Rate" asp-route-menuItemId="@item.MenuItemId" class="btn btn-sm btn-outline-warning">⭐ قيّم</a>
                    }
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="4" class="text-end">إجمالي الأصناف</th>
            <th>@order.TotalPrice.ToString("0.00") ج.م</th>
        </tr>
        @if (order.DiscountAmount > 0)
        {
            <tr>
                <th colspan="4" class="text-end">خصم@(string.IsNullOrEmpty(order.CouponCode) ? "" : $" ({order.CouponCode})")</th>
                <th>- @order.DiscountAmount.ToString("0.00") ج.م</th>
            </tr>
        }
        @if (order.DeliveryFee > 0)
        {
            <tr>
                <th colspan="4" class="text-end">مصاريف التوصيل</th>
                <th>@order.DeliveryFee.ToString("0.00") ج.م</th>
            </tr>
        }
        @if (order.DeliveryFee > 0 || order.DiscountAmount > 0)
        {
            <tr>
                <th colspan="4" class="text-end fw-bold">الإجمالي الكلي</th>
                <th class="fw-bold" style="color:var(--color-primary)">@order.GrandTotal.ToString("0.00") ج.م</th>
            </tr>
        }
    </tfoot>
</table>
</div>

<div class="alert alert-secondary">
    الدفع: كاش عند الاستلام — @(order.IsPaid ? "تم الدفع" : "لسه معلقة")
</div>
