@model OrderDetailsViewModel
@{
    ViewData["Title"] = "تفاصيل الطلب";
    var order = Model.Order;
    string statusText = order.Status switch
    {
        OrderStatus.Pending => "قيد الانتظار",
        OrderStatus.Accepted => "تم القبول",
        OrderStatus.Preparing => "جاري التحضير",
        OrderStatus.OutForDelivery => "مع مندوب التوصيل",
        OrderStatus.Delivered => "تم التسليم",
        OrderStatus.Cancelled => "ملغي",
        _ => order.Status.ToString()
    };
    string badgeClass = order.Status switch
    {
        OrderStatus.Delivered => "bg-success",
        OrderStatus.Cancelled => "bg-danger",
        OrderStatus.Pending => "bg-secondary",
        _ => "bg-warning text-dark"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3 gap-2">
    <h1 class="mb-0 fs-2">فاتورة @order.InvoiceNumber</h1>
    <span class="badge @badgeClass fs-6">@statusText</span>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card p-3">
            <dl class="info-list">
                <div>
                    <dt>تاريخ الطلب</dt>
                    <dd>@order.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
                </div>
                <div>
                    <dt>عنوان التوصيل</dt>
                    <dd>@order.DeliveryAddress</dd>
                </div>
                <div>
                    <dt>رقم الموبايل</dt>
                    <dd><a href="tel:@order.PhoneNumber" dir="ltr">@order.PhoneNumber</a></dd>
                </div>
                @if (!string.IsNullOrEmpty(order.Notes))
                {
                    <div>
                        <dt>ملاحظات</dt>
                        <dd>@order.Notes</dd>
                    </div>
                }
                @if (!string.IsNullOrEmpty(order.DeliveryPersonName))
                {
                    <div>
                        <dt>مندوب التوصيل</dt>
                        <dd>@order.DeliveryPersonName</dd>
                    </div>
                }
            </dl>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card p-3">
            @foreach (var item in order.OrderItems)
            {
                <div class="line-item">
                    <div>
                        <div class="line-item-name">@item.ItemNameAtOrderTime@(item.SizeNameAtOrderTime != null ? $" ({item.SizeNameAtOrderTime})" : "")</div>
                        <div class="line-item-sub">@item.UnitPriceAtOrderTime.ToString("0.00") ج.م × @item.Quantity</div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold text-nowrap">@item.LineTotal.ToString("0.00") ج.م</div>
                        @if (order.Status == OrderStatus.Delivered)
                        {
                            <a asp-controller="Review" asp-action="Rate" asp-route-menuItemId="@item.MenuItemId" class="btn btn-sm btn-outline-warning mt-1">⭐ قيّم</a>
                        }
                    </div>
                </div>
            }

            <div class="mt-2">
                <div class="summary-row">
                    <span>إجمالي الأصناف</span>
                    <span>@order.TotalPrice.ToString("0.00") ج.م</span>
                </div>
                @if (order.DiscountAmount > 0)
                {
                    <div class="summary-row">
                        <span>خصم@(string.IsNullOrEmpty(order.CouponCode) ? "" : $" ({order.CouponCode})")</span>
                        <span>- @order.DiscountAmount.ToString("0.00") ج.م</span>
                    </div>
                }
                @if (order.DeliveryFee > 0)
                {
                    <div class="summary-row">
                        <span>مصاريف التوصيل</span>
                        <span>@order.DeliveryFee.ToString("0.00") ج.م</span>
                    </div>
                }
                @if (order.DeliveryFee > 0 || order.DiscountAmount > 0)
                {
                    <div class="summary-row total">
                        <span>الإجمالي الكلي</span>
                        <span>@order.GrandTotal.ToString("0.00") ج.م</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="alert alert-secondary mt-3">
    الدفع: كاش عند الاستلام — @(order.IsPaid ? "تم الدفع" : "لسه معلقة")
</div>

<a asp-action="MyOrders" class="btn btn-outline-secondary">رجوع لأوردراتي</a>
