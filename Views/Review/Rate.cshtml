@model RateItemViewModel
@{
    ViewData["Title"] = "تقييم الصنف";
}

<h1 class="page-title">تقييم "@Model.MenuItemName"</h1>

<div class="card p-3 p-md-4 col-md-6">
    <form asp-action="Rate" method="post">
        <input type="hidden" asp-for="MenuItemId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">@Html.DisplayNameFor(m => m.Rating)</label>
            <div class="rate-choices">
                <label class="rate-choice">
                    <input type="radio" name="Rating" value="5" checked="@(Model.Rating == 5)" />
                    <span>⭐⭐⭐⭐⭐ ممتاز</span>
                </label>
                <label class="rate-choice">
                    <input type="radio" name="Rating" value="4" checked="@(Model.Rating == 4)" />
                    <span>⭐⭐⭐⭐ كويس جدًا</span>
                </label>
                <label class="rate-choice">
                    <input type="radio" name="Rating" value="3" checked="@(Model.Rating == 3)" />
                    <span>⭐⭐⭐ كويس</span>
                </label>
                <label class="rate-choice">
                    <input type="radio" name="Rating" value="2" checked="@(Model.Rating == 2)" />
                    <span>⭐⭐ مقبول</span>
                </label>
                <label class="rate-choice">
                    <input type="radio" name="Rating" value="1" checked="@(Model.Rating == 1)" />
                    <span>⭐ مش عاجبني</span>
                </label>
            </div>
            <span asp-validation-for="Rating" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Comment" class="form-label"></label>
            <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Comment" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">إرسال التقييم</button>
            <a asp-controller="Order" asp-action="MyOrders" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
