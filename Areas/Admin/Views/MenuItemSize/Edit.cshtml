@model MenuItemSizeFormViewModel
@{
    ViewData["Title"] = "تعديل مقاس";
}

<h1>تعديل مقاس "@Model.MenuItemName"</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="MenuItemId" />
    <input type="hidden" asp-for="MenuItemName" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DiscountedPrice" class="form-label"></label>
        <input asp-for="DiscountedPrice" class="form-control" />
        <span asp-validation-for="DiscountedPrice" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="VipPrice" class="form-label"></label>
        <input asp-for="VipPrice" class="form-control" />
        <span asp-validation-for="VipPrice" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DisplayOrder" class="form-label"></label>
        <input asp-for="DisplayOrder" class="form-control" />
        <span asp-validation-for="DisplayOrder" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
    <a asp-action="Index" asp-route-menuItemId="@Model.MenuItemId" class="btn btn-secondary">إلغاء</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
