@model List<MenuItemSize>
@{
    var menuItem = (MenuItem)ViewBag.MenuItem;
    ViewData["Title"] = "مقاسات " + menuItem.Name;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>مقاسات "@menuItem.Name"</h1>
    <a asp-action="Create" asp-route-menuItemId="@menuItem.Id" class="btn btn-primary">+ إضافة مقاس</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        الصنف ده لسه من غير مقاسات — لسه شغال بسعره الأساسي (@menuItem.Price.ToString("0.00") ج.م).
        أول ما تضيف مقاس، السعر الأساسي هيتجاهل والعميل هيختار من المقاسات دي بدل منه.
    </div>
}
else
{
    @* phones: one card per size *@
    <div class="d-md-none">
        @foreach (var size in Model)
        {
            <div class="card list-card">
                <div class="list-card-head">
                    <div class="list-card-title">@size.Name</div>
                    <span class="badge bg-warning text-dark">@size.Price.ToString("0.00") ج.م</span>
                </div>
                <dl class="list-card-meta">
                    <div><dt>سعر الخصم</dt><dd>@(size.DiscountedPrice.HasValue ? size.DiscountedPrice.Value.ToString("0.00") + " ج.م" : "-")</dd></div>
                    <div><dt>سعر العميل المميز</dt><dd>@(size.VipPrice.HasValue ? size.VipPrice.Value.ToString("0.00") + " ج.م 👑" : "-")</dd></div>
                    <div><dt>ترتيب العرض</dt><dd>@size.DisplayOrder</dd></div>
                </dl>
                <div class="list-card-actions">
                    <a asp-action="Edit" asp-route-id="@size.Id" class="btn btn-sm btn-outline-secondary">تعديل</a>
                    <a asp-action="Delete" asp-route-id="@size.Id" class="btn btn-sm btn-outline-danger">حذف</a>
                </div>
            </div>
        }
    </div>

    <div class="card p-3 d-none d-md-block">
    <div class="table-responsive">
<table class="table mb-0 align-middle no-stack">
        <thead>
            <tr>
                <th>المقاس</th>
                <th>السعر</th>
                <th>سعر الخصم</th>
                <th>سعر العميل المميز</th>
                <th>ترتيب العرض</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var size in Model)
            {
                <tr>
                    <td>@size.Name</td>
                    <td>@size.Price.ToString("0.00") ج.م</td>
                    <td>@(size.DiscountedPrice.HasValue ? size.DiscountedPrice.Value.ToString("0.00") + " ج.م" : "-")</td>
                    <td>@(size.VipPrice.HasValue ? size.VipPrice.Value.ToString("0.00") + " ج.م 👑" : "-")</td>
                    <td>@size.DisplayOrder</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@size.Id" class="btn btn-sm btn-outline-secondary">تعديل</a>
                        <a asp-action="Delete" asp-route-id="@size.Id" class="btn btn-sm btn-outline-danger">حذف</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
    </div>
}

<a asp-controller="MenuItem" asp-action="Index" class="btn btn-link">رجوع لإدارة المنيو</a>
