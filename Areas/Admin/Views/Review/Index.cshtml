@model List<Review>
@{
    ViewData["Title"] = "التقييمات";
    var selected = (int?)ViewBag.SelectedRating;
    var avg = (double)ViewBag.AverageRating;
    var total = (int)ViewBag.TotalCount;
}

<h1 class="page-title">تقييمات العملاء</h1>

<div class="row g-2 g-md-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card text-center h-100 stat-card">
            <div class="card-body">
                <div class="display-6">@avg.ToString("0.0") ⭐</div>
                <div class="text-muted small">متوسط التقييم العام</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100 stat-card">
            <div class="card-body">
                <div class="display-6">@total</div>
                <div class="text-muted small">إجمالي عدد التقييمات</div>
            </div>
        </div>
    </div>
</div>

<form method="get" class="mb-3 d-flex flex-wrap gap-2 align-items-center">
    <label class="form-label mb-0">فلترة بعدد النجوم:</label>
    <select name="rating" class="form-select" style="max-width:160px" onchange="this.form.submit()">
        <option value="">الكل</option>
        @for (int i = 5; i >= 1; i--)
        {
            <option value="@i" selected="@(selected == i)">@i ⭐</option>
        }
    </select>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">لا يوجد تقييمات حتى الآن.</div>
}
else
{
    <div class="row">
        @foreach (var review in Model)
        {
            <div class="col-12 col-lg-6">
                <div class="card review-card">
                    <div class="review-card-top">
                        <div>
                            <div class="fw-bold">@review.MenuItem?.Name</div>
                            <div class="review-stars">@(new string('⭐', review.Rating))</div>
                        </div>
                        <a asp-action="Delete" asp-route-id="@review.Id" class="btn btn-sm btn-outline-danger">حذف</a>
                    </div>
                    @if (!string.IsNullOrEmpty(review.Comment))
                    {
                        <p class="review-comment">@review.Comment</p>
                    }
                    <div class="review-meta">
                        <span>@(review.Customer?.FullName ?? "-")</span>
                        <span>@review.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</span>
                    </div>
                </div>
            </div>
        }
    </div>
}
