@model List<Review>
@{
    ViewData["Title"] = "التقييمات";
    var selected = (int?)ViewBag.SelectedRating;
    var avg = (double)ViewBag.AverageRating;
    var total = (int)ViewBag.TotalCount;
}

<h1 class="mb-3">تقييمات العملاء</h1>

<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6">@avg.ToString("0.0")</div>
                <div class="text-muted">متوسط التقييم العام</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6">@total</div>
                <div class="text-muted">إجمالي عدد التقييمات</div>
            </div>
        </div>
    </div>
</div>

<form method="get" class="mb-3 d-flex flex-wrap gap-2 align-items-center">
    <label class="form-label mb-0">فلترة بعدد النجوم:</label>
    <select name="rating" class="form-select" style="max-width:160px" onchange="this.form.submit()">
        <option value="">الكل</option>
        @for (int i = 5; i >= 1; i--)
        {
            <option value="@i" selected="@(selected == i)">@i ⭐</option>
        }
    </select>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">لا يوجد تقييمات حتى الآن.</div>
}
else
{
    <div class=" table-responsive" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <div class="card p-3">
    <table class="table align-middle mb-0" style="min-width: 700px;">
        <thead>
            <tr>
                <th>الصنف</th>
                <th>العميل</th>
                <th>التقييم</th>
                <th>التعليق</th>
                <th>التاريخ</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var review in Model)
            {
                <tr>
                    <td>@review.MenuItem?.Name</td>
                    <td>@review.Customer?.FullName</td>
                    <td>@(new string('⭐', review.Rating))</td>
                    <td>@(string.IsNullOrEmpty(review.Comment) ? "-" : review.Comment)</td>
                    <td>@review.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td><a asp-action="Delete" asp-route-id="@review.Id" class="btn btn-sm btn-outline-danger">حذف</a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    </div>
}