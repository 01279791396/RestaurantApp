@model List<Category>
@{
    ViewData["Title"] = "إدارة الأقسام";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>إدارة الأقسام</h1>
    <a asp-action="Create" class="btn btn-primary">+ إضافة قسم</a>
</div>

@* phones: one card per category *@
<div class="d-md-none">
    @foreach (var category in Model)
    {
        <div class="card list-card">
            <div class="list-card-head">
                <div class="list-card-title">@category.Name</div>
                <span class="badge bg-secondary">@category.MenuItems.Count صنف</span>
            </div>
            <dl class="list-card-meta">
                <div><dt>ترتيب العرض</dt><dd>@category.DisplayOrder</dd></div>
            </dl>
            <div class="list-card-actions">
                <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">تعديل</a>
                <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">حذف</a>
            </div>
        </div>
    }
</div>

<div class="card p-3 d-none d-md-block">
    <div class="table-responsive">
<table class="table mb-0 table-striped align-middle no-stack">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>ترتيب العرض</th>
            <th>عدد الأصناف</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.DisplayOrder</td>
                <td>@category.MenuItems.Count</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">تعديل</a>
                    <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
    </div>
