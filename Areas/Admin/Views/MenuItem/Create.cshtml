@model MenuItemFormViewModel
@{
    ViewData["Title"] = "إضافة صنف";
}

<h1>إضافة صنف جديد</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DiscountedPrice" class="form-label"></label>
        <input asp-for="DiscountedPrice" class="form-control" placeholder="سيبه فاضي لو مفيش عرض" />
        <span asp-validation-for="DiscountedPrice" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="VipPrice" class="form-label"></label>
        <input asp-for="VipPrice" class="form-control" placeholder="سيبه فاضي لو الصنف مالوش سعر مميز" />
        <span asp-validation-for="VipPrice" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
            <option value="">-- اختار القسم --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Image" class="form-label"></label>
        <input asp-for="Image" type="file" accept=".jpg,.jpeg,.jfif,.png,.webp,image/*" class="form-control" />
        <span asp-validation-for="Image" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsAvailable" class="form-check-input" />
        <label asp-for="IsAvailable" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">حفظ</button>
    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
