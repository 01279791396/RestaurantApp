@model List<ApplicationUser>
@{
    ViewData["Title"] = "العملاء";
}

<h1 class="mb-4">العملاء</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">لسه مفيش عملاء مسجلين.</div>
}
else
{
    @* phones: one card per customer *@
    <div class="d-md-none">
        @foreach (var customer in Model)
        {
            <div class="card list-card">
                <div class="list-card-head">
                    <div>
                        <div class="list-card-title">@customer.FullName</div>
                        <div class="list-card-sub" dir="ltr">@customer.Email</div>
                    </div>
                    @if (customer.IsVip)
                    {
                        <span class="badge bg-dark">عميل مميز 👑</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">عادي</span>
                    }
                </div>
                <dl class="list-card-meta">
                    <div><dt>رقم الموبايل</dt><dd><a href="tel:@customer.PhoneNumber" dir="ltr">@customer.PhoneNumber</a></dd></div>
                </dl>
                <div class="list-card-actions">
                    <form asp-action="ToggleVip" asp-route-id="@customer.Id" method="post">
                        <button type="submit" class="btn btn-sm @(customer.IsVip ? "btn-outline-secondary" : "btn-outline-primary")">
                            @(customer.IsVip ? "إلغاء التميز" : "خليه عميل مميز")
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="card p-3 d-none d-md-block">
    <div class="table-responsive">
<table class="table mb-0 align-middle no-stack">
        <thead>
            <tr>
                <th>الاسم</th>
                <th>البريد الإلكتروني</th>
                <th>رقم الموبايل</th>
                <th>الحالة</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in Model)
            {
                <tr>
                    <td>@customer.FullName</td>
                    <td>@customer.Email</td>
                    <td>@customer.PhoneNumber</td>
                    <td>
                        @if (customer.IsVip)
                        {
                            <span class="badge bg-dark">عميل مميز 👑</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark">عادي</span>
                        }
                    </td>
                    <td>
                        <form asp-action="ToggleVip" asp-route-id="@customer.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm @(customer.IsVip ? "btn-outline-secondary" : "btn-outline-dark")">
                                @(customer.IsVip ? "إلغاء التميز" : "خليه عميل مميز")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
    </div>
}
