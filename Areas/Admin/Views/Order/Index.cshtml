@model List<Order>
@{
    ViewData["Title"] = "الأوردرات";
    var selected = (OrderStatus?)ViewBag.SelectedStatus;
    var showArchived = (bool)ViewBag.ShowArchived;

    string StatusText(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "قيد الانتظار",
        OrderStatus.Accepted => "تم القبول",
        OrderStatus.Preparing => "جاري التحضير",
        OrderStatus.OutForDelivery => "مع مندوب التوصيل",
        OrderStatus.Delivered => "تم التسليم",
        OrderStatus.Cancelled => "ملغي",
        _ => s.ToString()
    };
    string BadgeClass(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "bg-secondary",
        OrderStatus.Delivered => "bg-success",
        OrderStatus.Cancelled => "bg-danger",
        _ => "bg-warning text-dark"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="mb-0">@(showArchived ? "الأرشيف" : "الأوردرات")</h1>
    <div class="d-flex gap-2 flex-wrap">
        @if (showArchived)
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">⬅ رجوع للقايمة الأساسية</a>
        }
        else
        {
            <a asp-action="Index" asp-route-showArchived="true" class="btn btn-sm btn-outline-secondary">📦 عرض الأرشيف</a>
            <a asp-action="ArchiveIncompleteConfirm" class="btn btn-sm btn-outline-warning">📦 أرشفة الملغي وغير المكتمل</a>
            <a asp-action="ClearAllConfirm" class="btn btn-sm btn-outline-danger">🗑️ مسح كل الأوردرات</a>
        }
    </div>
</div>

<form method="get" class="mb-3 d-flex flex-wrap gap-2 align-items-center">
    <input type="hidden" name="showArchived" value="@showArchived" />
    <label class="form-label mb-0">فلترة بالحالة:</label>
    <select name="status" class="form-select" style="max-width:220px" onchange="this.form.submit()">
        <option value="">الكل</option>
        @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
        {
            <option value="@s" selected="@(selected == s)">@StatusText(s)</option>
        }
    </select>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">@(showArchived ? "الأرشيف فاضي." : "لا يوجد أوردرات.")</div>
}
else
{
    <div class="d-md-none">
        @foreach (var order in Model)
        {
            <div class="card list-card">
                <div class="list-card-head">
                    <div>
                        <div class="list-card-title">@order.InvoiceNumber</div>
                        <div class="list-card-sub">@(order.Customer?.FullName ?? "-")</div>
                    </div>
                    <span class="badge @BadgeClass(order.Status)">@StatusText(order.Status)</span>
                </div>
                <dl class="list-card-meta">
                    <div><dt>الإجمالي</dt><dd>@order.TotalPrice.ToString("0.00") ج.م</dd></div>
                    <div><dt>التاريخ</dt><dd>@order.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</dd></div>
                    <div><dt>مندوب التوصيل</dt><dd>@(order.DeliveryPersonName ?? "-")</dd></div>
                </dl>
                <div class="list-card-actions">
                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">التفاصيل</a>
                    <form asp-action="ToggleArchive" asp-route-id="@order.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">@(showArchived ? "رجّعه" : "أرشفة")</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="card p-3 d-none d-md-block">
        <div class="table-responsive">
            <table class="table mb-0 table-striped align-middle no-stack">
                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>العميل</th>
                        <th>الإجمالي</th>
                        <th>الحالة</th>
                        <th>مندوب التوصيل</th>
                        <th>التاريخ</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.InvoiceNumber</td>
                            <td>@order.Customer?.FullName</td>
                            <td class="fw-bold">@order.TotalPrice.ToString("0.00") ج.م</td>
                            <td><span class="badge @BadgeClass(order.Status)">@StatusText(order.Status)</span></td>
                            <td>@(order.DeliveryPersonName ?? "-")</td>
                            <td>@order.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                            <td class="text-nowrap">
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">التفاصيل</a>
                                <form asp-action="ToggleArchive" asp-route-id="@order.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@(showArchived ? "رجّعه" : "أرشفة")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
