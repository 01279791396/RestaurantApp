@model List<Order>
@{
    ViewData["Title"] = "الأوردرات";
    var selected = (OrderStatus?)ViewBag.SelectedStatus;
}

<h1 class="mb-4">الأوردرات</h1>

<form method="get" class="mb-3 d-flex gap-2 align-items-center">
    <label class="form-label mb-0">فلترة بالحالة:</label>
    <select name="status" class="form-select" style="width:220px" onchange="this.form.submit()">
        <option value="">الكل</option>
        @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
        {
            <option value="@s" selected="@(selected == s)">@s</option>
        }
    </select>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">لا يوجد أوردرات.</div>
}
else
{
    <div class="card p-3" >
        <div class=" table-responsive" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
            <table class="table align-middle mb-0" style="min-width: 700px;">
                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>العميل</th>
                        <th>الإجمالي</th>
                        <th>الحالة</th>
                        <th>مندوب التوصيل</th>
                        <th>التاريخ</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.InvoiceNumber</td>
                            <td>@order.Customer?.FullName</td>
                            <td class="fw-bold">@order.TotalPrice.ToString("0.00") ج.م</td>
                            <td>
                                <span class="badge @(order.Status == OrderStatus.Pending ? "bg-secondary" : order.Status == OrderStatus.Delivered ? "bg-success" : order.Status == OrderStatus.Cancelled ? "bg-danger" : "bg-warning text-dark")">
                                    @order.Status
                                </span>
                            </td>
                            <td>@(order.DeliveryPersonName ?? "-")</td>
                            <td>@order.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                            <td><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">التفاصيل</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
  
    </div>
}
