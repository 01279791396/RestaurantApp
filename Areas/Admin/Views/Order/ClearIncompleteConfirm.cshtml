@{
    ViewData["Title"] = "مسح الأوردرات غير المكتملة";
    var count = (int)ViewBag.OrderCount;
}

<h1>مسح الأوردرات غير المكتملة</h1>

<div class="alert alert-danger">
    <strong>تحذير:</strong> الإجراء ده هيمسح <strong>@count أوردر</strong> نهائيًا —
    يعني كل أوردر حالته <strong>مش "تم التسليم"</strong> (ملغي، قيد الانتظار، مقبول، جاري التحضير، أو مع مندوب التوصيل).
    <br /><br />
    الأوردرات اللي <strong>"تم التسليم"</strong> فعلاً (سجل المبيعات الحقيقي) <strong>مش هتتأثر ومش هتتمسح</strong>.
</div>

<form asp-action="ClearIncomplete" method="post">
    <button type="submit" class="btn btn-danger">
        أيوه، امسح الـ @count أوردر دول
    </button>
    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
</form>